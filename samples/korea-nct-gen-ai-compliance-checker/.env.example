# =============================================================================
# korea-nct-gen-ai-compliance-checker 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-project-id
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 데이터 보관 및 처리 대상 국내 리전
# - 예시: TARGET_REGION=asia-northeast3
# - 미입력 시 gcloud config(gcloud config get-value compute/region) 활성 설정 또는 사내 권장 리전(asia-northeast3)에서 읽어온다.
TARGET_REGION=

# 대상 Google Cloud 조직 ID (조직 정책 점검 시 필요)
# - 예시: ORGANIZATION_ID=123456789012
# - 미입력 시 gcloud config 및 gcloud organizations list 활성 설정에서 읽어온다.
ORGANIZATION_ID=

