# 대상 GCP 프로젝트 ID (미입력 시 gcloud 설정 자동 감지)
# 예시: PROJECT_ID=my-project-id
PROJECT_ID=

# 데이터 보관 및 처리 대상 국내 리전 (미입력 시 기본값: asia-northeast3)
# 예시: TARGET_REGION=asia-northeast3
TARGET_REGION=

# (선택 사항) 조직 ID (조직 정책 점검 시 필요, 미입력 시 상위 조직 자동 감지)
# 예시: ORGANIZATION_ID=123456789012
ORGANIZATION_ID=

