# =============================================================================
# gemini-resilience-checker 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: SCAN_PATH=), 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 스캔 대상 소스 코드 디렉터리 경로
# - 예시: SCAN_PATH=./src
# - 미입력 시 현재 작업 디렉터리(.)가 적용된다.
SCAN_PATH=
