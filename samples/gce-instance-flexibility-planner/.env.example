# =============================================================================
# gce-instance-flexibility-planner 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-compute-project
# - 미입력 시 gcloud config 활성 프로젝트에서 자동 감지한다.
PROJECT_ID=

# 점검 대상 리전 (Region)
# - 예시: REGION=asia-northeast3
# - 미입력 시 gcloud config 활성 리전 또는 사내 권장 리전(asia-northeast3)을 자동 선택한다.
REGION=

# 유연성 설계 대상 플랫폼 (all, gke, gce)
# - 기본값: all (GKE ComputeClass 매니페스트 및 GCE MIG instanceSelections 동시 생성)
TARGET_PLATFORM=all

# 기준 머신 타입 또는 목표 사양 (Base Machine Shape)
# - 예시: BASE_MACHINE_TYPE=n2-standard-8
# - 미입력 시 사내 클러스터/인스턴스 템플릿의 주력 머신 타입을 자동 분석한다.
BASE_MACHINE_TYPE=
