# Google Cloud 아키텍처 명세 실전 루브릭 평가기 환경 변수 설정
# 본 설정 파일의 값을 비워둘 경우 gcloud 활성 설정 및 현재 경로의 BRD/SDD 문서를 자동으로 감지한다.

# 참고용 Google Cloud 프로젝트 ID (선택 사항, 예: example-project)
PROJECT_ID=

# 평가 대상 SDD 또는 TDD 마크다운 문서 경로 (선택 사항, 미입력 시 docs/TDD.md 또는 SDD.md 자동 탐색)
SPEC_PATH=

# 추적성 대조 대상 BRD 마크다운 문서 경로 (선택 사항, 미입력 시 docs/BRD.md 자동 탐색)
BRD_PATH=
