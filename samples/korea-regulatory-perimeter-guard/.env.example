# =============================================================================
# korea-fsi-regulatory-perimeter-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상(프로젝트, 리전, 버킷, CMEK 키)을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=example-fsi-corp
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 대상 리전
# - 예시: LOCATION=asia-northeast3
# - 미입력 시 gcloud config(gcloud config get-value compute/region) 활성 설정 또는 사내 권장 리전(asia-northeast3 서울 리전)에서 읽어온다.
LOCATION=

# 점검 대상 Cloud Storage 버킷 이름 (감사 로그 및 AI 데이터 저장용)
# - 예시: AUDIT_BUCKET_NAME=example-fsi-audit-logs
# - 미입력 시 프로젝트 내 존재하는 버킷(fsi, audit, log 관련 버킷 우선)을 자동 감지한다.
AUDIT_BUCKET_NAME=

# 점검 대상 Cloud KMS CMEK 키 리소스 전체 경로
# - 예시: KMS_KEY_NAME=projects/example-fsi-corp/locations/asia-northeast3/keyRings/fsi-keyring/cryptoKeys/fsi-cmek-key
# - 미입력 시 해당 리전 내에 등록된 Cloud KMS 키링 및 암호화 키를 자동 감지한다.
KMS_KEY_NAME=
