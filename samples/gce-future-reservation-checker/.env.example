# =============================================================================
# gce-future-reservation-checker 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gpu-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 대상 영역 또는 리전 (예: us-central1-a, us-south1-a, asia-northeast3-a)
# - 예시: LOCATION=asia-northeast3-a
# - 미입력 시 프로젝트 내 전체 영역을 대상으로 조회한다.
LOCATION=
