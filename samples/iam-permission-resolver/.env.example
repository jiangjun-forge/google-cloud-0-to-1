# =============================================================================
# iam-permission-resolver 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-target-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 감사 로그 조회 대상 최근 기간 일수
# - 예시: DAYS=7
# - 미입력 시 사내 권장 기본값(7일)이 적용된다.
DAYS=

# 조회 대상 실패 로그 최대 건수
# - 예시: LIMIT_COUNT=5
# - 미입력 시 사내 권장 기본값(5건)이 적용된다.
LIMIT_COUNT=
