# =============================================================================
# stt-lro-quota-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상 프로젝트 및 설정을 강제할 때만 값을 채워 넣는다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID (비워둘 경우 gcloud 활성 프로젝트 자동 감지)
# 예시: PROJECT_ID=my-speech-production-project
PROJECT_ID=

# Speech-to-Text V2 리전 위치 (기본값: us-central1 또는 asia-northeast3)
# 예시: LOCATION=us-central1
LOCATION=

# 예상 동시 비동기 배치 음성 인식 작업 수 (기본값: 10)
# 예시: CONCURRENCY=15
CONCURRENCY=
