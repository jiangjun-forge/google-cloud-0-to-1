# 진단 대상 Google Cloud 조직 ID (숫자, 미입력 시 기본값: 123456789012)
# 예시: TARGET_ORG_ID=123456789012
TARGET_ORG_ID=

# 자사 허용 승인 도메인 (미입력 시 기본값: example-corp.com)
# 예시: ALLOWED_DOMAIN=example-corp.com
ALLOWED_DOMAIN=

# Context-Aware Access 인가 대상 사내 보안 그룹 이메일 (미입력 시 기본값: gcp-authorized-users@example-corp.com)
# 예시: AUTHORIZED_GROUP_EMAIL=gcp-authorized-users@example-corp.com
AUTHORIZED_GROUP_EMAIL=

# SWG 관문 프록시 엔드포인트 URL (미입력 시 기본값: https://swg-proxy.internal.example-corp.com:8080)
# 예시: SWG_PROXY_URL=https://swg-proxy.internal.example-corp.com:8080
SWG_PROXY_URL=

