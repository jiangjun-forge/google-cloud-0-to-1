# swg-tenant-access-guard 환경 변수 설정 템플릿
# 복사하여 .env 파일을 생성한 후 운영 환경에 맞게 값을 수정하여 사용한다.

# 진단 대상 Google Cloud 조직 ID (숫자)
TARGET_ORG_ID=123456789012

# 자사 허용 승인 도메인 (예: example-corp.com)
ALLOWED_DOMAIN=example-corp.com

# Context-Aware Access 인가 대상 사내 보안 그룹 이메일
AUTHORIZED_GROUP_EMAIL=gcp-authorized-users@example-corp.com

# SWG 관문 프록시 엔드포인트 URL (모의 검증용)
SWG_PROXY_URL=https://swg-proxy.internal.example-corp.com:8080
