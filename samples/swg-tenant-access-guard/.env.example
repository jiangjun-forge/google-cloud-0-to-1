# =============================================================================
# swg-tenant-access-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: TARGET_ORG_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 조직 ID
# - 예시: TARGET_ORG_ID=123456789012
# - 미입력 시 gcloud config 및 gcloud organizations list 활성 설정에서 읽어온다.
TARGET_ORG_ID=

# 자사 허용 승인 도메인
# - 예시: ALLOWED_DOMAIN=example-corp.com
# - 미입력 시 사내 설정(example-corp.com)이 적용된다.
ALLOWED_DOMAIN=

# Context-Aware Access 인가 대상 사내 보안 그룹 이메일
# - 예시: AUTHORIZED_GROUP_EMAIL=gcp-authorized-users@example-corp.com
# - 미입력 시 사내 설정(gcp-authorized-users@example-corp.com)이 적용된다.
AUTHORIZED_GROUP_EMAIL=

# SWG 관문 프록시 엔드포인트 URL
# - 예시: SWG_PROXY_URL=https://swg-proxy.internal.example-corp.com:8080
# - 미입력 시 사내 설정(https://swg-proxy.internal.example-corp.com:8080)이 적용된다.
SWG_PROXY_URL=

