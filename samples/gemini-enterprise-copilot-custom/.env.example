# Gemini Enterprise 커스텀 에이전트 팩토리 및 Gemini Enterprise app 연동기 환경 변수 템플릿
#
# 본 파일의 키 값을 비워둘 경우 diagnose.py가 gcloud 활성 설정 및 사내 리소스에서
# 프로젝트 ID, 리전 등을 스마트하게 자동 감지(Auto-Discovery)합니다.
# 특정 프로젝트나 환경을 명시적으로 고정하고 싶을 때만 값을 채워 넣으십시오.

# 1. Google Cloud 프로젝트 ID (비워둘 경우 gcloud config 활성 프로젝트 자동 채택)
PROJECT_ID=

# 2. Agent Engine 배포 리전 (기본값: us-central1)
REGION=

# 3. Gemini Enterprise App 인스턴스 ID (비워둘 경우 사내 기본값 자동 탐지)
GE_APP_ID=

# 4. 커스텀 에이전트 서비스 계정 이메일 (비워둘 경우 기본 서비스 계정 자동 탐색)
# 예: custom-agent-sa@<PROJECT_ID>.iam.gserviceaccount.com
CUSTOM_AGENT_SERVICE_ACCOUNT=

# 5. 연동 대상 BigQuery 데이터셋 ID (선택 사항)
BQ_DATASET_ID=
