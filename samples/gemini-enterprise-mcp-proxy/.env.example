# Gemini Enterprise 사설 MCP 브리지 프록시 환경 변수 설정
# 본 설정 파일의 값을 비워둘 경우 기본값 또는 gcloud 활성 설정을 자동 감지한다.

# 사내 사설망 또는 온프레미스 MCP 서버 엔드포인트 URL (예: http://10.10.0.5:8000/mcp)
UPSTREAM_MCP_URL=

# 인바운드 토큰 검증 방식: google_tokeninfo, jwt, introspect (기본값: google_tokeninfo)
# - IdP가 Google Identity/Google Workspace인 경우: google_tokeninfo (Google Access Token 검증)
# - IdP가 Okta, Microsoft Entra ID, Auth0, Keycloak인 경우: jwt (JWKS 서명 검증)
# - IdP가 RFC 7662 인트로스펙션을 요구하는 경우: introspect
AUTH_MODE=

# 업스트림 백엔드 전달 인증 방식: none, static_bearer, google_adc (기본값: none)
# - 사내 백엔드가 무인증/사설망 전용인 경우: none
# - 사내 백엔드가 고정 API 토큰을 요구하는 경우: static_bearer
# - 사내 백엔드가 Google Cloud Run/App Engine이며 IAM 인증을 요구하는 경우: google_adc
UPSTREAM_AUTH=

# [AUTH_MODE=jwt 시 필수] IdP JWKS 엔드포인트 URL (예: https://idp.example.com/.well-known/jwks.json)
OAUTH_JWKS_URL=

# [AUTH_MODE=jwt 시 필수] 토큰 대상자(Audience) 식별자
OAUTH_AUDIENCE=

# [AUTH_MODE=jwt 시 선택] 토큰 발급자(Issuer) 식별자
OAUTH_ISSUER=

# [AUTH_MODE=introspect 시 필수] RFC 7662 인트로스펙션 엔드포인트 URL
INTROSPECT_URL=
INTROSPECT_CLIENT_ID=
INTROSPECT_CLIENT_SECRET=

# [UPSTREAM_AUTH=static_bearer 시 필수] 업스트림 전달용 정적 Bearer 토큰
UPSTREAM_STATIC_BEARER=

# [UPSTREAM_AUTH=google_adc 시 필수] 대상 Cloud Run / GCP 서비스 Audience URL
UPSTREAM_AUDIENCE=

# 토큰 검증 결과 인메모리 캐시 유지 시간 (초 단위, 기본값: 60)
TOKEN_CACHE_TTL=

# Cloud Run Direct VPC Egress 서브넷 설정 (Cloud Run 배포 시 필요)
VPC_NETWORK=
VPC_SUBNET=
