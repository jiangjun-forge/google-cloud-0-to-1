# Cloud Armor 기반 Java4Shell (CVE-2026-114938) 가상 패치 및 노출 진단기 환경 변수 설정
# 본 설정 파일의 값을 비워둘 경우 gcloud 활성 설정 및 사내 Cloud Armor 정책, 백엔드 리소스를 자동으로 감지한다.

# 점검 대상 Google Cloud 프로젝트 ID (선택 사항, 예: example-project)
PROJECT_ID=

# 점검 대상 리전 (선택 사항, 기본값: asia-northeast3)
REGION=

# 점검 대상 Cloud Armor Security Policy 이름 (선택 사항, 미입력 시 프로젝트 내 정책 자동 감지)
CLOUD_ARMOR_POLICY=

# 점검 대상 External ALB Backend Service 이름 (선택 사항, 미입력 시 연결된 백엔드 서비스 자동 감지)
BACKEND_SERVICE=
