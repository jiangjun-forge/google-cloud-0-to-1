# =============================================================================
# gemini-enterprise-prompt-miner 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gemini-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# Vertex AI 리전 (기본값: asia-northeast3)
# - 예시: LOCATION=asia-northeast3
LOCATION=asia-northeast3

# BigQuery 프롬프트 감사 로그 데이터세트 ID (기본값: gemini_logging)
# - 예시: BQ_DATASET_ID=gemini_logging
BQ_DATASET_ID=gemini_logging

# 도출할 업무 군집(Cluster) 수 K (기본값: auto - 모수 및 업무 분화도에 따라 자율 적응형 도출, 숫자 지정 시 고정)
# - 예시: CLUSTERS=auto 또는 CLUSTERS=12
CLUSTERS=auto

# 분석 대상 최근 기간 일수 (기본값: 30)
# - 예시: DAYS=30
DAYS=30

# 프라이버시 보호: 인라인 PII(주민번호, 전화번호, 이메일, 계좌번호 등) 마스킹 활성화 (기본값: true)
ENABLE_PII_MASKING=true

# 멀티 턴 대화 세션 묶음 분석 여부 (기본값: true - 동일 세션의 사용자 질의를 단일 워크플로우 단위로 병합)
GROUP_MULTI_TURN=true
