# =============================================================================
# service-account-leak-investigator 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-project-id
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 침해 의심 서비스 계정 이메일 목록 (콤마 구분)
# - 예시: COMPROMISED_SA_EMAILS=compromised-sa1@my-project-id.iam.gserviceaccount.com,compromised-sa2@my-project-id.iam.gserviceaccount.com
# - 미입력 시 사내 활성 서비스 계정을 자동 감지하여 읽어온다.
COMPROMISED_SA_EMAILS=

# 감사 로그 조회 기간 (일 단위)
# - 예시: LOOKBACK_DAYS=7
# - 미입력 시 사내 권장 기본값(7)이 적용된다.
LOOKBACK_DAYS=

