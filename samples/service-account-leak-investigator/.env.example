# 대상 GCP 프로젝트 ID (미입력 시 gcloud 설정 자동 감지)
# 예시: PROJECT_ID=my-project-id
PROJECT_ID=

# 침해 의심 서비스 계정 이메일 목록 (콤마 구분, 미입력 시 프로젝트 내 기본 서비스 계정 자동 탐지)
# 예시: COMPROMISED_SA_EMAILS=compromised-sa1@my-project-id.iam.gserviceaccount.com,compromised-sa2@my-project-id.iam.gserviceaccount.com
COMPROMISED_SA_EMAILS=

# 감사 로그 조회 기간 (일 단위, 미입력 시 기본값: 7)
# 예시: LOOKBACK_DAYS=7
LOOKBACK_DAYS=

