# =============================================================================
# gemini-quota-cost-alert 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gemini-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
PROJECT_ID=

# Cloud Billing 계정 ID
# - 예시: BILLING_ACCOUNT_ID=012345-6789AB-CDEF01
# - 미입력 시 프로젝트에 연계된 활성 빌링 계정을 자동 감지한다.
BILLING_ACCOUNT_ID=

# 월간 예산 한도 금액 (USD)
# - 예시: BUDGET_AMOUNT=100
# - 미입력 시 기본값(100 USD)이 적용된다.
BUDGET_AMOUNT=

# 예산 초과 알림 임계치 비율 (0.0 ~ 2.0)
# - 예시: ALERT_THRESHOLD=0.9
# - 미입력 시 기본값(0.9: 90%)이 적용된다.
ALERT_THRESHOLD=

# Pub/Sub 알림 주제(Topic) 이름
# - 예시: PUBSUB_TOPIC=gemini-cost-alerts
# - 미입력 시 기본값(gemini-cost-alerts)이 적용된다.
PUBSUB_TOPIC=

# 예산 경보 규칙 표시 이름
# - 예시: BUDGET_NAME=gemini-budget-alert
# - 미입력 시 기본값(gemini-budget-alert)이 적용된다.
BUDGET_NAME=
