# =============================================================================
# embedding-dimension-tradeoff-analyzer 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-ml-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# Vertex AI 리전 위치
# - 예시: LOCATION=asia-northeast3
# - 미입력 시 gcloud config(gcloud config get-value compute/region) 활성 설정 또는 사내 권장 리전(asia-northeast3 서울 리전)에서 읽어온다.
LOCATION=

# 임베딩 파운데이션 모델 이름
# - 예시: MODEL_NAME=text-embedding-005
# - 미입력 시 사내 권장 기본값(text-embedding-005)이 적용된다.
MODEL_NAME=

# 비교할 임베딩 차원 목록 (콤마 구분)
# - 예시: DIMENSIONS=768,512,256,128
# - 미입력 시 사내 권장 기본값(768,512,256,128)이 적용된다.
DIMENSIONS=

# 평가 테스트용 샘플 건수
# - 예시: SAMPLE_COUNT=1000
# - 미입력 시 사내 권장 기본값(1000)이 적용된다.
SAMPLE_COUNT=

# 스토리지 및 인덱스 용량 추산용 전사 기준 벡터 수
# - 예시: PROJECTED_VECTOR_COUNT=1000000
# - 미입력 시 사내 권장 기본값(1,000,000)이 적용된다.
PROJECTED_VECTOR_COUNT=

# 사내 실데이터 파일 경로 (CSV, JSONL, TXT 지원)
# - 예시: DATA_PATH=./data/sample_documents.jsonl
# - 미입력 시 내장 벤치마크 데이터를 사용한다.
DATA_PATH=
