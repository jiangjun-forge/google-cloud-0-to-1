# =============================================================================
# gemini-enterprise-cross-org-agent-resolver 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: GE_PROJECT_ID=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# Gemini Enterprise 웹 앱이 호스팅된 GCP 프로젝트 ID
# - 예시: GE_PROJECT_ID=ge-app-prod
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
GE_PROJECT_ID=

# 커스텀 에이전트(Agent Engine)가 배포된 타 프로젝트 ID
# - 예시: AGENT_PROJECT_ID=custom-agent-ml-prod
# - 미입력 시 기본 데모 프로젝트가 모의 진단에 사용된다.
AGENT_PROJECT_ID=

# 대상 리전
# - 예시: LOCATION=asia-northeast3
# - 미입력 시 기본값(asia-northeast3 서울 리전)이 적용된다.
LOCATION=

# Agent Engine 고유 ID
# - 예시: REASONING_ENGINE_ID=8492049182740192841
# - 미입력 시 프로젝트 내 배포된 에이전트 엔진을 자동 탐색한다.
REASONING_ENGINE_ID=
