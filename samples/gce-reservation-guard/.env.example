# =============================================================================
# gce-reservation-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gce-project
# - 미입력 시 gcloud config 활성 프로젝트에서 자동 감지한다.
PROJECT_ID=

# 점검 대상 리전 (Region)
# - 예시: REGION=asia-northeast3
# - 미입력 시 gcloud config 활성 리전 또는 사내 권장 리전(asia-northeast3)을 자동 선택한다.
REGION=asia-northeast3

# 점검 대상 머신 패밀리 목록 (콤마 구분)
# - 기본값: n4,n2,g2,a2
MACHINE_FAMILIES=n4,n2,g2,a2

# 에러 감사 로그 조회 기간 (일 단위)
# - 기본값: 14 (최근 14일)
INSPECT_DAYS=14
