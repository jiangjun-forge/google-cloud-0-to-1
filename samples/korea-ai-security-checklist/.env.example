# =============================================================================
# korea-ai-security-checklist 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gemini-project
# - 미입력 시 gcloud config 활성 프로젝트에서 자동 감지한다.
PROJECT_ID=

# 점검 대상 리전 (Region)
# - 기본값: asia-northeast3 (대한민국 서울 리전)
REGION=asia-northeast3

# 진단 대상 AI 서비스 범위 (all, gemini-api, gemini-enterprise)
# - 기본값: all (Gemini API / Vertex AI 및 Gemini Enterprise App 동시 점검)
TARGET_SERVICE=all

# 검증할 Cloud Storage 감사 로그 버킷 (선택 사항)
# - 미입력 시 프로젝트 내 기본 버킷을 자동 감지한다.
AUDIT_BUCKET=
