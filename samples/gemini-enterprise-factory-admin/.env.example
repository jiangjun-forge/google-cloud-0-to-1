# Gemini Enterprise 어드민 코파일럿 환경 변수 템플릿 (.env.example)
# 값을 비워둘 경우(KEY=) gcloud 활성 계정, 프로젝트 및 사내 리소스에서 실시간 자동 감지됩니다.
# 특정 프로젝트, 리전, 앱 ID를 수동 고정하려는 경우에만 값을 입력하십시오.

# [필수] 구글 클라우드 프로젝트 ID (비워둘 경우 gcloud config 활성 프로젝트 자동 채택)
PROJECT_ID=

# [선택] Vertex AI 및 Discovery Engine 배포 리전 (기본: global)
LOCATION=

# [선택] Gemini Enterprise App 인스턴스 ID (비워둘 경우 사내 활성 엔진 자동 감지)
GE_APP_ID=

# [선택] 어드민 진단 실행 서비스 계정 이메일 (비워둘 경우 ge-admin-sa 자동 유도)
ADMIN_SERVICE_ACCOUNT=

# [선택] 사내 Cloud Identity / Workspace 도메인 (예: example.com)
CUSTOMER_DOMAIN=
