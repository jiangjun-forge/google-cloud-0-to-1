# =============================================================================
# bigquery-data-agent-starter 환경 설정 (45분 완성 스몰셋 핸즈온)
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 기본 데이터셋(cymbal_gold)과 테이블 스키마는 bigquery-data-agent-semantic-enricher와 호환되도록 구성되어,
#   스타터 실습 후 시맨틱 메타데이터 보강 전후(Before/After) 정확도 비교 시연을 즉시 이어갈 수 있다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-analytics-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 워크숍 실습용 BigQuery 스몰셋 데이터셋 ID
# - 예시: DATASET_ID=cymbal_gold
# - 미입력 시 사내 권장 기본값(cymbal_gold)이 적용된다.
DATASET_ID=

# BigQuery 리전
# - 예시: LOCATION=asia-northeast3
# - 미입력 시 gcloud config 활성 설정 또는 사내 권장 기본값(asia-northeast3)이 적용된다.
LOCATION=

# BigQuery Data Agent 고유 식별자 이름
# - 예시: DATA_AGENT_NAME=cymbal-retail-data-agent
# - 미입력 시 사내 권장 기본값(cymbal-retail-data-agent)이 적용된다.
DATA_AGENT_NAME=

# [선택 사항] BigQuery Data Agent를 게시할 대상 Gemini Enterprise App (Engine) ID
# - 예시: GE_APP_ID=omni-retail-ge-app_1720000000
# - 단독(Standalone)으로 BigQuery Studio에서만 사용할 경우 비워둔다.
GE_APP_ID=
