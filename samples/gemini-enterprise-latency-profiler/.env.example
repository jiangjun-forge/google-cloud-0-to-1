# =============================================================================
# gemini-enterprise-latency-profiler 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gemini-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 대상 Gemini Enterprise App (GE App) Engine ID
# - 예시: GE_APP_ID=my-ge-app-id
# - 미입력 시 사내 프로비저닝된 GE App을 실시간 자동 감지하거나 대화형으로 선택한다.
GE_APP_ID=

# 엔드포인트 리전 (GE App 어시스턴트는 global 엔드포인트 기본 적용)
# - 예시: LOCATION=global
# - 미입력 시 사내 권장 기본값(global)이 적용된다.
LOCATION=

# 테스트 대상 모델 ID (대조군 Vertex AI Gemini 스트리밍 비교용)
# - 예시: MODEL_ID=gemini-3.8-flash
# - 미입력 시 사내 권장 기본값(gemini-3.8-flash)이 적용된다.
MODEL_ID=

# 벤치마크 테스트 프롬프트
# - 예시: PROMPT=사내 보안 규정 요약 및 주요 수칙 3가지를 알려줘.
# - 미입력 시 기본 벤치마크 프롬프트가 사용된다.
PROMPT=
