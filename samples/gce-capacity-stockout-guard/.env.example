# =============================================================================
# gce-capacity-stockout-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: GCP_PROJECT_ID=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 진단 대상 Google Cloud 프로젝트 ID
# - 예시: GCP_PROJECT_ID=my-compute-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
GCP_PROJECT_ID=

# 점검 대상 리전
# - 예시: INSPECT_REGION=us-central1
# - 미입력 시 기본값(us-central1)이 적용된다.
INSPECT_REGION=

# 점검 대상 머신 패밀리 (콤마 구분)
# - 예시: INSPECT_MACHINE_FAMILIES=n4,n2
# - 미입력 시 기본값(n4,n2)이 적용된다.
INSPECT_MACHINE_FAMILIES=

# 최근 에러 감사 로그 조회 기간 (일 단위)
# - 예시: INSPECT_DAYS=14
# - 미입력 시 기본값(14일)이 적용된다.
INSPECT_DAYS=
