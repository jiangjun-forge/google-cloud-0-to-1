# Cloud NAT 포트 고갈 및 패킷 드롭 진단기 환경 변수 설정
# 본 설정 파일의 값을 비워둘 경우 gcloud 활성 설정 및 사내 Cloud NAT 리소스를 자동으로 감지한다.

# 점검 대상 Google Cloud 프로젝트 ID (선택 사항, 예: example-project)
PROJECT_ID=

# 점검 대상 리전 (선택 사항, 기본값: asia-northeast3)
REGION=

# 점검 대상 Cloud Router 이름 (선택 사항, 미입력 시 리전 내 라우터 자동 감지)
ROUTER_NAME=

# 점검 대상 Cloud NAT 게이트웨이 이름 (선택 사항, 미입력 시 라우터 내 NAT 게이트웨이 자동 감지)
NAT_NAME=

# 모니터링 메트릭 분석 조회 기간 (일 단위, 기본값: 7)
LOOKBACK_DAYS=
