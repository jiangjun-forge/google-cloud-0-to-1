# =============================================================================
# gke-source-ip-snat-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gke-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
PROJECT_ID=

# 대상 GKE 클러스터 이름
# - 예시: CLUSTER_NAME=prod-core-cluster
# - 미입력 시 기본값(prod-core-cluster) 또는 프로젝트 내 활성 클러스터를 자동 감지한다.
CLUSTER_NAME=

# 대상 리전 또는 영역
# - 예시: LOCATION=asia-northeast3
# - 미입력 시 기본값(asia-northeast3 서울 리전)이 적용된다.
LOCATION=

# 대상 Ingress/Service 네임스페이스
# - 예시: NAMESPACE=ingress-gateway
# - 미입력 시 전체 네임스페이스를 대상으로 검사한다.
NAMESPACE=

# 대상 서비스 이름
# - 예시: SERVICE_NAME=kong-proxy-internal
# - 미입력 시 네임스페이스 내 전체 LoadBalancer 서비스를 검사한다.
SERVICE_NAME=
