# Multi-Cluster GKE Inference Gateway 환경 변수 템플릿
# 키 이름만 선언하고 값은 비워둡니다 (KEY=).
# 값을 비워둘 경우 gcloud 활성 프로젝트 및 사내 로드 밸런서 리소스에서 자동 탐지합니다.

# 대상 GCP 프로젝트 ID (미입력 시 gcloud config 활성 프로젝트 자동 탐지)
PROJECT_ID=

# 진단 대상 Global External Application Load Balancer URL Map 이름 (선택적 오버라이드)
URL_MAP_NAME=

# 대상 인퍼런스 경로 (기본값: /v1/chat/completions)
INFERENCE_PATH=
