# =============================================================================
# bigquery-data-agent-semantic-enricher 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-analytics-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
PROJECT_ID=

# 대상 BigQuery 데이터셋 ID
# - 예시: DATASET_ID=cymbal_gold
# - 미입력 시 기본값(cymbal_gold)이 적용된다.
DATASET_ID=

# 데이터셋 및 Dataplex 리전
# - 예시: LOCATION=asia-northeast3
# - 미입력 시 기본값(asia-northeast3 서울 리전)이 적용된다.
LOCATION=

# 시맨틱 메타데이터 생성용 Gemini 모델 ID
# - 예시: GEMINI_MODEL=gemini-2.5-flash
# - 미입력 시 기본값(gemini-2.5-flash)이 적용된다.
GEMINI_MODEL=

# BigQuery 스키마 메타데이터 자동 패치 적용 여부 (true/false)
# - 예시: AUTO_APPLY=false
# - 미입력 시 기본값(false: 진단 및 보강 계획만 출력)이 적용된다.
AUTO_APPLY=
