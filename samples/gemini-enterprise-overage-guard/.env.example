# gemini-enterprise-overage-guard 환경 변수 설정 템플릿
# 복사하여 .env 파일을 생성한 후 운영 환경에 맞게 값을 수정하여 사용한다.

# 진단 대상 GCP 프로젝트 ID
PROJECT_ID=demo-project

# Cloud Billing 계정 ID
BILLING_ACCOUNT_ID=012345-6789AB-CDEF01

# 월간 오버리지 지출 한도 상한선 (USD 단위, 예: 1000)
SPEND_CAP_USD=1000

# 예산 알림 임계치 백분율 (기본값: 80)
ALERT_THRESHOLD_PERCENT=80
