# =============================================================================
# gemini-enterprise-overage-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gemini-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# Cloud Billing 계정 ID
# - 예시: BILLING_ACCOUNT_ID=012345-6789AB-CDEF01
# - 미입력 시 기본 데모 빌링 계정이 모의 진단에 사용된다.
BILLING_ACCOUNT_ID=

# 월간 오버리지 지출 한도 상한선 (USD 단위)
# - 예시: SPEND_CAP_USD=1000
# - 미입력 시 사내 권장 기본값(1000.0 USD)이 적용된다.
SPEND_CAP_USD=

# 예산 알림 임계치 백분율 (50 ~ 100)
# - 예시: ALERT_THRESHOLD_PERCENT=80
# - 미입력 시 사내 권장 기본값(80%)이 적용된다.
ALERT_THRESHOLD_PERCENT=
