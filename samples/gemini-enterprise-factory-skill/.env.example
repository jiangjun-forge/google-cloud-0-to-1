#
# Gemini Enterprise 자율형 사내 스킬 팩토리 환경 변수 템플릿
#
# 본 파일의 키 값을 비워둘 경우 diagnose.py가 gcloud 활성 설정 및 사내 리소스에서
# 프로젝트 ID, 리전 등을 스마트하게 자동 감지(Auto-Discovery)합니다.
# 특정 프로젝트나 환경을 명시적으로 고정하고 싶을 때만 값을 채워 넣으십시오.

# 1. Google Cloud 프로젝트 ID (비워둘 경우 gcloud config 활성 프로젝트 자동 채택)
PROJECT_ID=

# 2. Gemini Enterprise / Discovery Engine 리전 (기본값: global 또는 asia-northeast3)
LOCATION=

# 3. Gemini Enterprise App 인스턴스 ID (비워둘 경우 사내 기본값 자동 탐지)
GE_APP_ID=

# 4. 스킬 실행 대행 서비스 계정 이메일 (Secret Manager 접근 및 API 대행)
# 예: ge-skill-invoker-sa@<PROJECT_ID>.iam.gserviceaccount.com
SKILL_INVOKER_SERVICE_ACCOUNT=

# 5. 연동 대상 Secret Manager 시크릿 이름 (선택 사항)
# 예: slack-webhook-url, jira-api-token
SECRET_NAME=
