# =============================================================================
# gce-region-latency-probe 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: TARGET_GPU_TYPE=), 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gpu-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
PROJECT_ID=

# 허용 최대 왕복 지연 시간 (밀리초 단위)
# - 예시: MAX_LATENCY_THRESHOLD_MS=100.0
# - 미입력 시 기본값(100.0ms)이 적용된다.
MAX_LATENCY_THRESHOLD_MS=

# 필터링할 대상 GPU 유형 (A100, H100, L4, G4 등)
# - 예시: TARGET_GPU_TYPE=H100
# - 미입력 시 전체 GPU 지원 리전을 종합 프로빙한다.
TARGET_GPU_TYPE=
