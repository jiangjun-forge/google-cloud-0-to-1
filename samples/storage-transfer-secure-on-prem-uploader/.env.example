# =============================================================================
# storage-transfer-secure-on-prem-uploader 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-project-id
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 타깃 Cloud Storage 버킷명
# - 예시: TARGET_BUCKET=my-secure-media-bucket
# - 미입력 시 사내 활성 버킷을 자동 감지하여 읽어온다.
TARGET_BUCKET=

# Storage Transfer Service 온프레미스 에이전트 풀 이름
# - 예시: AGENT_POOL=on-prem-posix-pool
# - 미입력 시 사내 활성 에이전트 풀을 자동 감지하여 읽어온다.
AGENT_POOL=

# 전송 대역폭 제한 (MB/s 단위)
# - 예시: BANDWIDTH_LIMIT_MB=100
# - 미입력 시 사내 권장 기본값(100)이 적용된다.
BANDWIDTH_LIMIT_MB=

