# 대상 GCP 프로젝트 ID (미입력 시 gcloud 설정 자동 감지)
# 예시: PROJECT_ID=my-project-id
PROJECT_ID=

# 타깃 Cloud Storage 버킷명 (미입력 시 기본값: secure-media-archive)
# 예시: TARGET_BUCKET=my-secure-media-bucket
TARGET_BUCKET=

# Storage Transfer Service 온프레미스 에이전트 풀 이름 (미입력 시 기본값: on-prem-posix-pool)
# 예시: AGENT_POOL=on-prem-posix-pool
AGENT_POOL=

# 전송 대역폭 제한 (MB/s 단위, 미입력 시 기본값: 100)
# 예시: BANDWIDTH_LIMIT_MB=100
BANDWIDTH_LIMIT_MB=

