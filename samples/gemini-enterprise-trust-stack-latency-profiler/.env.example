# Google Cloud Project ID
PROJECT_ID=example-corp

# Google Cloud Region (e.g. asia-northeast3, us-central1, global)
LOCATION=asia-northeast3

# Target Gemini Model ID
MODEL_ID=gemini-2.5-flash

# Model Armor Template Name (Optional, e.g. projects/example-corp/locations/asia-northeast3/templates/fsi-guard)
MODEL_ARMOR_TEMPLATE=projects/example-corp/locations/asia-northeast3/templates/default-guard

# Test Prompt for Benchmarking
PROMPT=최근 엔터프라이즈 환경에서 보안 거버넌스와 LLM 추론 지연 시간 간의 트레이드오프를 설명해 줘.
