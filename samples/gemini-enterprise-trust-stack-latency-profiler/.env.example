# =============================================================================
# gemini-enterprise-trust-stack-latency-profiler 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gemini-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
PROJECT_ID=

# 엔드포인트 리전
# - 예시: LOCATION=asia-northeast3
# - 미입력 시 기본값(asia-northeast3 서울 리전)이 적용된다.
LOCATION=

# 테스트 대상 모델 ID
# - 예시: MODEL_ID=gemini-2.5-flash
# - 미입력 시 기본값(gemini-2.5-flash)이 적용된다.
MODEL_ID=

# Model Armor 검사용 템플릿 리소스 경로
# - 예시: MODEL_ARMOR_TEMPLATE=projects/my-project/locations/asia-northeast3/templates/default-guard
# - 미입력 시 리전 내 Model Armor 템플릿을 자동 탐색한다.
MODEL_ARMOR_TEMPLATE=

# 벤치마크 테스트 프롬프트
# - 예시: PROMPT=엔터프라이즈 보안 거버넌스와 LLM 지연 시간 트레이드오프 분석
# - 미입력 시 기본 벤치마크 프롬프트가 사용된다.
PROMPT=
