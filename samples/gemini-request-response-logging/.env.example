# =============================================================================
# gemini-request-response-logging 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-gemini-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
PROJECT_ID=

# Vertex AI 리전 위치
# - 예시: LOCATION=asia-northeast3
# - 미입력 시 기본값(asia-northeast3 서울 리전)이 적용된다.
LOCATION=

# BigQuery 적재 데이터세트 ID
# - 예시: BIGQUERY_DATASET=gcp_logs
# - 미입력 시 기본값(gcp_logs)이 적용된다.
BIGQUERY_DATASET=

# 대상 파운데이션 모델 식별자
# - 예시: MODEL_ID=gemini-2.5-flash
# - 미입력 시 기본값(gemini-2.5-flash)이 적용된다.
MODEL_ID=
