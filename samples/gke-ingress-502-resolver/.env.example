# GKE Ingress 502 Bad Gateway 원인 체인 역추적기 환경 변수 설정
# 본 설정 파일의 값을 비워둘 경우 gcloud 활성 설정 및 사내 GKE 클러스터를 자동으로 감지한다.

# 점검 대상 Google Cloud 프로젝트 ID (선택 사항, 예: example-project)
PROJECT_ID=

# 점검 대상 GKE 클러스터 리전 또는 존 (선택 사항, 기본값: asia-northeast3)
LOCATION=

# 점검 대상 GKE 클러스터 이름 (선택 사항, 미입력 시 클러스터 목록 자동 감지)
CLUSTER_NAME=

# 점검 대상 쿠버네티스 네임스페이스 (선택 사항, 기본값: default)
NAMESPACE=

# 점검 대상 Ingress 또는 Gateway 리소스 이름 (선택 사항, 미입력 시 네임스페이스 내 전체 점검)
INGRESS_NAME=
