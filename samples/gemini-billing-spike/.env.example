# =============================================================================
# gemini-billing-spike 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: GOOGLE_CLOUD_PROJECT=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: GOOGLE_CLOUD_PROJECT=my-gemini-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
GOOGLE_CLOUD_PROJECT=

# 분석 대상 조회 기간 (일 단위)
# - 예시: LOOKBACK_DAYS=90
# - 미입력 시 사내 권장 기본값(90일)이 적용된다.
LOOKBACK_DAYS=
