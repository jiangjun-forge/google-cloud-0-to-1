# =============================================================================
# gemini-billing-spike 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: GOOGLE_CLOUD_PROJECT=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: GOOGLE_CLOUD_PROJECT=my-gemini-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
GOOGLE_CLOUD_PROJECT=

# 분석 대상 조회 기간 (일 단위)
# - 예시: LOOKBACK_DAYS=90
# - 미입력 시 기본값(90일)이 적용된다.
LOOKBACK_DAYS=
