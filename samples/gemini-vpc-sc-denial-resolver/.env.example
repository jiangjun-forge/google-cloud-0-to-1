# =============================================================================
# gemini-vpc-sc-denial-resolver 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-secure-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
PROJECT_ID=

# 감사 로그 조회 대상 최근 기간 일수
# - 예시: DAYS=7
# - 미입력 시 기본값(7일)이 적용된다.
DAYS=

# 조회 대상 실패 로그 최대 건수
# - 예시: LIMIT_COUNT=5
# - 미입력 시 기본값(5건)이 적용된다.
LIMIT_COUNT=
