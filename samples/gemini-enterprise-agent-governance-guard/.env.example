# =============================================================================
# gemini-enterprise-agent-governance-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-enterprise-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 대상 Gemini Enterprise 애플리케이션 ID 또는 이름
# - 예시: APP_ID=default-enterprise-agent-app
# - 미입력 시 사내 권장 기본값(default-enterprise-agent-app)이 적용된다.
APP_ID=

# 대상 Workforce Identity 풀 ID
# - 예시: WORKFORCE_POOL_ID=entra-id-workforce-pool
# - 미입력 시 프로젝트 내 활성 Workforce 풀을 자동 탐지한다.
WORKFORCE_POOL_ID=
