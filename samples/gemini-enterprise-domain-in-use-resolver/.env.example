# =============================================================================
# gemini-enterprise-domain-in-use-resolver 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: TARGET_DOMAIN=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 점검 대상 사내 기업 도메인
# - 예시: TARGET_DOMAIN=example-corp.com
# - 미입력 시 사내 권장 기본값(example.com)이 적용된다.
TARGET_DOMAIN=

# DNS 검증 레코드 호스트
# - 예시: DNS_HOST=@
# - 미입력 시 루트(@) 레코드를 기본값으로 검증한다.
DNS_HOST=
