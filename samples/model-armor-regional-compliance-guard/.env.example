# 대상 GCP 프로젝트 ID (미입력 시 gcloud 설정 자동 감지)
# 예시: PROJECT_ID=my-project-id
PROJECT_ID=

# 대상 리전 (미입력 시 기본값: asia-northeast3 서울 리전)
# 예시: LOCATION=asia-northeast3
LOCATION=

# 대상 Model Armor 템플릿 ID (선택 사항, 미입력 시 리전 내 전체 템플릿 검사)
# 예시: TEMPLATE_ID=ma-template-korea-finance
TEMPLATE_ID=

