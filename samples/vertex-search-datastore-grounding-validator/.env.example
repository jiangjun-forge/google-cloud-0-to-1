# 대상 GCP 프로젝트 ID (미입력 시 gcloud 설정 자동 감지)
# 예시: PROJECT_ID=my-project-id
PROJECT_ID=

# 데이터 저장소 리전 위치 (미입력 시 기본값: global)
# 예시: LOCATION=global
LOCATION=

# 점검 대상 Vertex AI Search 데이터 저장소 ID (미입력 시 프로젝트 내 첫 번째 저장소 자동 감지)
# 예시: DATASTORE_ID=enterprise-knowledge-ds
DATASTORE_ID=

# 원본 Cloud Storage 버킷 이름 (선택 사항, 미입력 시 데이터 저장소 설정에서 자동 감지)
# 예시: SOURCE_GCS_BUCKET=my-enterprise-docs
SOURCE_GCS_BUCKET=

# 그라운딩 검색 품질 검증용 프로브 질의어 (미입력 시 기본 질의어 사용)
# 예시: TEST_QUERY=2026 클라우드 보안 정책 가이드라인
TEST_QUERY=

