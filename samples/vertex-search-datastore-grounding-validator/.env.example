# =============================================================================
# vertex-search-datastore-grounding-validator 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-project-id
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 데이터 저장소 리전 위치
# - 예시: LOCATION=global
# - 미입력 시 gcloud config(gcloud config get-value compute/region) 활성 설정 또는 사내 권장 리전(global)에서 읽어온다.
LOCATION=

# 점검 대상 Vertex AI Search 데이터 저장소 ID
# - 예시: DATASTORE_ID=enterprise-knowledge-ds
# - 미입력 시 사내 활성 리소스를 자동 감지하여 읽어온다.
DATASTORE_ID=

# 원본 Cloud Storage 버킷 이름 (선택 사항)
# - 예시: SOURCE_GCS_BUCKET=my-enterprise-docs
# - 미입력 시 사내 활성 리소스를 자동 감지하여 읽어온다.
SOURCE_GCS_BUCKET=

# 그라운딩 검색 품질 검증용 프로브 질의어
# - 예시: TEST_QUERY=2026 클라우드 보안 정책 가이드라인
# - 미입력 시 사내 표준 프로브 질의어가 적용된다.
TEST_QUERY=

