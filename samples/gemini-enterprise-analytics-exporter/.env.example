# =============================================================================
# gemini-enterprise-analytics-exporter 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-analytics-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# BigQuery 적재 데이터세트 이름
# - 예시: BQ_DATASET=gemini_analytics
# - 미입력 시 사내 권장 기본값(gemini_analytics)이 적용된다.
BQ_DATASET=

# BigQuery 적재 테이블 이름
# - 예시: BQ_TABLE=user_adoption_metrics
# - 미입력 시 사내 권장 기본값(user_adoption_metrics)이 적용된다.
BQ_TABLE=

# 유휴 라이선스 판별 기준 일수
# - 예시: INACTIVITY_DAYS_THRESHOLD=30
# - 미입력 시 사내 권장 기본값(30일)이 적용된다.
INACTIVITY_DAYS_THRESHOLD=
