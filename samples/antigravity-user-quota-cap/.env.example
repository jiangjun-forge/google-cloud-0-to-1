# =============================================================================
# antigravity-user-quota-cap 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-antigravity-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 쿼터 집계 기간 (daily, weekly, monthly)
# - 기본값: daily
CAP_PERIOD=daily

# 사용자별 토큰 상한 임계치 (Tokens)
# - 기본값: 500000 (일일 50만 토큰)
CAP_TOKENS=500000

# 사용자별 요청 횟수 상한 임계치 (Requests)
# - 기본값: 1000
CAP_REQUESTS=1000
