# =============================================================================
# fcm-push-quota-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID (Firebase 프로젝트)
# - 예시: PROJECT_ID=my-firebase-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# 피크 시 분당 푸시 발송 시도량
# - 예시: PEAK_MESSAGES_PER_MINUTE=750000
# - 미입력 시 사내 권장 기본값(750,000건/분)이 적용된다.
PEAK_MESSAGES_PER_MINUTE=

# 현재 프로젝트의 분당 다운스트림 메시지 할당량
# - 예시: CURRENT_QUOTA_LIMIT_PER_MINUTE=600000
# - 미입력 시 사내 권장 기본값(600,000건/분)이 적용된다.
CURRENT_QUOTA_LIMIT_PER_MINUTE=
