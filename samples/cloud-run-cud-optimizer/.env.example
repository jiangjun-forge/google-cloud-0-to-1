# =============================================================================
# cloud-run-cud-optimizer 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-run-project
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# Cloud Billing 계정 ID
# - 예시: BILLING_ACCOUNT_ID=012345-6789AB-CDEF01
# - 미입력 시 기본 데모 빌링 계정이 모의 진단에 사용된다.
BILLING_ACCOUNT_ID=

# 시계열 사용량 분석 기간 (일 단위)
# - 예시: LOOKBACK_DAYS=90
# - 미입력 시 사내 권장 기본값(90일)이 적용된다.
LOOKBACK_DAYS=

# 안전 마진 계수 (0.5 ~ 0.95)
# - 예시: SAFETY_MARGIN=0.85
# - 미입력 시 사내 권장 기본값(0.85: 최저 사용량의 85% 권장)이 적용된다.
SAFETY_MARGIN=
