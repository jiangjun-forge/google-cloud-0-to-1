# cloud-run-cud-optimizer 환경 변수 설정 템플릿
# 복사하여 .env 파일을 생성한 후 운영 환경에 맞게 값을 수정하여 사용한다.

# 진단 대상 Cloud Billing 계정 ID (예: 01ABCD-2345EF-6789GH)
BILLING_ACCOUNT_ID=012345-6789AB-CDEF01

# 분석 대상 GCP 프로젝트 ID
PROJECT_ID=demo-project

# 시계열 분석 기간 (일 단위, 기본값: 90)
LOOKBACK_DAYS=90

# 안전 마진 계수 (0.5 ~ 0.95, 기본값: 0.85)
# 최저 사용량(Trough)의 몇 %까지 약정할 것인지 지정한다.
SAFETY_MARGIN=0.85
