# [안내] 키 값을 비워두면(KEY=) 실행 시 gcloud 활성 설정 및 사내 GCP 환경으로부터 실시간 자동 탐지한다.
# 특정 리소스를 명시적으로 고정하고 싶을 때만 값을 입력한다.

# 1. 진단 대상 GCP 프로젝트 ID (미입력 시 gcloud config get-value project 자동 감지)
PROJECT_ID=

# 2. 사내 금융 인프라 배포 리전 (미입력 시 asia-northeast3 서울 리전 기본 적용)
REGION=

# 3. Gemini API 호출 리전 및 모델 (미입력 시 global 및 gemini-3.8-flash 기본 적용)
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=

# 4. 혁신 금융 서비스 집중 심사 영역 (all, consumer_benefit, regulatory_necessity, service_innovativeness, technical_security)
SANDBOX_CATEGORY=

# 5. 사전 점검할 혁신 금융 서비스 신청서 초안 파일 경로 (선택 사항, 마크다운/텍스트)
PROPOSAL_PATH=
