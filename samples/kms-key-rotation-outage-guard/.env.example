# =============================================================================
# kms-key-rotation-outage-guard 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), gcloud config 활성 설정 및 사내 리소스를 자동으로 읽어온다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-project-id
# - 미입력 시 gcloud config(gcloud config get-value project) 활성 설정에서 읽어온다.
PROJECT_ID=

# KMS 키 링 위치
# - 예시: KMS_LOCATION=asia-northeast3
# - 미입력 시 gcloud config(gcloud config get-value compute/region) 활성 설정 또는 사내 권장 리전(asia-northeast3)에서 읽어온다.
KMS_LOCATION=

# Cloud KMS 키 링 이름
# - 예시: KEY_RING=prod-keyring
# - 미입력 시 사내 활성 키 링을 자동 감지하여 읽어온다.
KEY_RING=

# Cloud KMS 암호화 키 이름
# - 예시: KEY_NAME=customer-data-key
# - 미입력 시 사내 활성 암호화 키를 자동 감지하여 읽어온다.
KEY_NAME=

# 검증 대상 Cloud Storage 버킷 이름
# - 예시: BUCKET_NAME=my-encrypted-bucket
# - 미입력 시 사내 활성 버킷을 자동 감지하여 읽어온다.
BUCKET_NAME=

