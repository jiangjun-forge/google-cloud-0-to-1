# 대상 GCP 프로젝트 ID (미입력 시 gcloud 설정 자동 감지)
# 예시: PROJECT_ID=my-project-id
PROJECT_ID=

# KMS 키 링 위치 (미입력 시 기본값: asia-northeast3)
# 예시: KMS_LOCATION=asia-northeast3
KMS_LOCATION=

# KMS 키 링 이름 (미입력 시 첫 번째 감지된 키 링 자동 사용)
# 예시: KEY_RING=prod-keyring
KEY_RING=

# KMS 암호화 키 이름 (미입력 시 첫 번째 감지된 키 자동 사용)
# 예시: KEY_NAME=customer-data-key
KEY_NAME=

# 검증 대상 Cloud Storage 버킷 이름 (미입력 시 사내 버킷 자동 감지)
# 예시: BUCKET_NAME=my-encrypted-bucket
BUCKET_NAME=

