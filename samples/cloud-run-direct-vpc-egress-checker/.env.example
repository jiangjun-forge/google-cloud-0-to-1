# =============================================================================
# cloud-run-direct-vpc-egress-checker 환경 설정
#
# [안내]
# - 키 뒤의 값을 비워두면(예: PROJECT_ID=), 활성 gcloud 설정 및 기본값을 자동으로 적용한다.
# - 특정 대상을 명시적으로 고정하고자 할 때만 주석 예시를 참고하여 값을 입력한다.
# =============================================================================

# 대상 Google Cloud 프로젝트 ID
# - 예시: PROJECT_ID=my-run-project
# - 미입력 시 gcloud 활성 프로젝트(gcloud config get-value project)를 자동 감지한다.
PROJECT_ID=

# 대상 Cloud Run 배포 리전
# - 예시: REGION=asia-northeast3
# - 미입력 시 기본값(asia-northeast3 서울 리전)이 적용된다.
REGION=

# 점검 대상 Cloud Run 서비스 이름
# - 예시: SERVICE_NAME=order-processing-api
# - 미입력 시 지정 리전 내의 Cloud Run 서비스 전체를 자동 탐색하여 점검한다.
SERVICE_NAME=

# Direct VPC Egress 연동 VPC 네트워크 이름
# - 예시: VPC_NETWORK=default
# - 미입력 시 Cloud Run 설정에 바인딩된 서브넷/네트워크를 자동 탐지한다.
VPC_NETWORK=

# Direct VPC Egress 연동 서브넷 이름
# - 예시: SUBNET_NAME=serverless-subnet
# - 미입력 시 Cloud Run 설정에 바인딩된 서브넷을 자동 탐지한다.
SUBNET_NAME=
